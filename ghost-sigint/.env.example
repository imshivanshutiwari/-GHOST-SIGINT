# ─── Security ───────────────────────────────────────────────────
SECRET_KEY=changeme_at_least_64_hex_chars_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ─── Database ────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./ghost_sigint.db
REDIS_URL=redis://redis:6379/0

# ─── RF / DSP ────────────────────────────────────────────────────
FS=1000000.0
TARGET_POWER=-20.0

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://nginx:80"]

# ─── Environment ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
